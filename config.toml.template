#https://developers.openai.com/codex/config-reference

#model_provider = "my"
model = "gpt-5.5"
plan_mode_reasoning_effort = "xhigh"
model_reasoning_effort = "xhigh"
model_reasoning_summary = "detailed"
approval_policy = "never" # untrusted | on-request | never
sandbox_mode = "danger-full-access" # read-only | workspace-write | danger-full-access

[shell_environment_policy]
inherit = "all" 
ignore_default_excludes = false

[sandbox_workspace_write]
network_access = true

[analytics]
enabled = false

[model_providers.my]
name = "my"
base_url = ""
env_key = "OPENAI_API_KEY"
wire_api = "responses"

[tui]
status_line = ["model-with-reasoning", "fast-mode", "permissions", "context-used", "git-branch", "current-dir", "thread-title", "approval-mode", "context-window-size", "used-tokens", "total-input-tokens", "total-output-tokens", "thread-id"]
status_line_use_colors = true

